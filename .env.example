# Home Fund environment. `make` copies this to .env on first run and exports it.
# Values are for processes running on the host against `make up`; inside compose,
# services override hosts with service names (postgres, ollama, budget-mcp, ...).
# Keep values unquoted: the Makefile includes this file directly.
# Every secret below is a DEV-ONLY placeholder. Never reuse them anywhere real.

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homefund
POSTGRES_PORT=5432
APP_RW_PASSWORD=app_rw_dev_password
MCP_RO_PASSWORD=mcp_ro_dev_password
# Migrations and role setup only.
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@localhost:5432/homefund
# app_rw: api, agent (LangGraph checkpointer), importer, ingest, seed.
DATABASE_URL_APP=postgresql+psycopg://app_rw:app_rw_dev_password@localhost:5432/homefund
# mcp_ro: budget-mcp and guides-mcp (SELECT on transactions, monthly_summaries, goals, guide_chunks).
DATABASE_URL_MCP=postgresql+psycopg://mcp_ro:mcp_ro_dev_password@localhost:5432/homefund

# --- Column encryption (merchant, raw_description) and dedupe ------------------
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COLUMN_ENCRYPTION_KEY=jh53wfOcX8t6c9PCtXy3dtNWJ6oUN1NdQBL_UqfHCSM=
DEDUPE_HMAC_KEY=dev-only-dedupe-key-change-me

# --- Models (private network only) --------------------------------------------
OLLAMA_PORT=11434
# OpenAI-compatible endpoint: Ollama in dev, vLLM in production.
LLM_BASE_URL=http://localhost:11434/v1
LLM_PLANNER_MODEL=gpt-oss:20b
LLM_SMALL_MODEL=qwen3.5:9b
# embed service: BGE-M3 dense + sparse, bge-reranker-v2-m3.
EMBED_URL=http://localhost:8200
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Service URLs ---------------------------------------------------------------
BUDGET_MCP_URL=http://localhost:8101/mcp
HOUSING_MCP_URL=http://localhost:8102/mcp
GUIDES_MCP_URL=http://localhost:8103/mcp
AGENT_URL=http://localhost:8300
API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173

# --- Time -----------------------------------------------------------------------
# Set to YYYY-MM-DD to run every service on a FixedClock (demos, evals). Empty = system clock.
CLOCK_FIXED_DATE=

# --- Outside APIs (allowlisted egress) -----------------------------------------
# housing-mcp: api.stlouisfed.org, api.rentcast.io
FRED_API_KEY=
RENTCAST_API_KEY=
# Use fixtures/mocks instead of live FRED and RentCast calls.
HOUSING_USE_MOCKS=true
# importer: Plaid, only when enabled.
PLAID_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
