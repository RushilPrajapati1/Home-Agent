{
  "$defs": {
    "AnswerRequest": {
      "additionalProperties": false,
      "description": "Answers the question the graph asked at ask_user.",
      "properties": {
        "answer": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "title": "AnswerRequest",
      "type": "object"
    },
    "AnswerResponse": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PlanStatus"
        }
      },
      "required": [
        "plan_id",
        "status"
      ],
      "title": "AnswerResponse",
      "type": "object"
    },
    "Cashflow": {
      "additionalProperties": false,
      "description": "Income, spending by category and fixed bills over the last N full months.",
      "properties": {
        "by_category": {
          "items": {
            "$ref": "#/$defs/CategorySpend"
          },
          "title": "By Category",
          "type": "array"
        },
        "fixed_bills": {
          "items": {
            "$ref": "#/$defs/FixedBill"
          },
          "title": "Fixed Bills",
          "type": "array"
        },
        "fixed_bills_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Fixed Bills Monthly",
          "type": "string"
        },
        "months": {
          "maximum": 12,
          "minimum": 1,
          "title": "Months",
          "type": "integer"
        },
        "period_end": {
          "description": "Last full month included",
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "saved_monthly": {
          "description": "take_home_monthly - spending_monthly",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Saved Monthly",
          "type": "string"
        },
        "spending_monthly": {
          "description": "Average spend, excluding Income and Transfer",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Spending Monthly",
          "type": "string"
        },
        "take_home_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Take Home Monthly",
          "type": "string"
        }
      },
      "required": [
        "months",
        "period_start",
        "period_end",
        "take_home_monthly",
        "spending_monthly",
        "saved_monthly",
        "by_category",
        "fixed_bills",
        "fixed_bills_monthly"
      ],
      "title": "Cashflow",
      "type": "object"
    },
    "Category": {
      "enum": [
        "Dining and delivery",
        "Groceries",
        "Travel fund",
        "Shopping",
        "Rideshare",
        "Subscriptions",
        "Entertainment",
        "Rent",
        "Insurance",
        "Utilities",
        "Debt minimum",
        "Income",
        "Transfer",
        "Other"
      ],
      "title": "Category",
      "type": "string"
    },
    "CategorySpend": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "monthly_avg": {
          "description": "Average monthly outflow, positive",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Monthly Avg",
          "type": "string"
        },
        "transactions": {
          "description": "Transaction count over the whole period",
          "minimum": 0,
          "title": "Transactions",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "monthly_avg",
        "transactions"
      ],
      "title": "CategorySpend",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "document": {
          "description": "Document title, e.g. 'CFPB: Your home loan toolkit'",
          "title": "Document",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short supporting excerpt",
          "title": "Quote"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GuideSource"
        },
        "tax_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Year"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "chunk_id",
        "source",
        "document",
        "section"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "description": "Cash needed and monthly payment for one home. Produced only by housing-mcp.",
      "properties": {
        "cash_needed": {
          "description": "down_payment + closing_costs + reserves",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Cash Needed",
          "type": "string"
        },
        "closing_cost_pct": {
          "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Closing Cost Pct",
          "type": "string"
        },
        "closing_costs": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Closing Costs",
          "type": "string"
        },
        "down_payment": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Down Payment",
          "type": "string"
        },
        "down_pct": {
          "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Down Pct",
          "type": "string"
        },
        "insurance_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Insurance Monthly",
          "type": "string"
        },
        "insurance_rate_pct": {
          "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Insurance Rate Pct",
          "type": "string"
        },
        "loan_amount": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Loan Amount",
          "type": "string"
        },
        "monthly_payment": {
          "description": "piti_monthly + pmi_monthly",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Monthly Payment",
          "type": "string"
        },
        "piti_monthly": {
          "description": "Principal + interest + property tax + insurance",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Piti Monthly",
          "type": "string"
        },
        "pmi_monthly": {
          "description": "Zero when down_pct >= 20",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Pmi Monthly",
          "type": "string"
        },
        "pmi_rate_pct": {
          "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Pmi Rate Pct",
          "type": "string"
        },
        "price": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Price",
          "type": "string"
        },
        "principal_interest_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Principal Interest Monthly",
          "type": "string"
        },
        "property_tax_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Property Tax Monthly",
          "type": "string"
        },
        "property_tax_rate_pct": {
          "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Property Tax Rate Pct",
          "type": "string"
        },
        "rate_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate As Of"
        },
        "rate_pct": {
          "description": "30-year fixed rate used",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Rate Pct",
          "type": "string"
        },
        "reserve_months": {
          "description": "Months of PITI held as reserves",
          "minimum": 0,
          "title": "Reserve Months",
          "type": "integer"
        },
        "reserves": {
          "description": "reserve_months x PITI, rounded to the nearest $100",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Reserves",
          "type": "string"
        }
      },
      "required": [
        "price",
        "down_pct",
        "down_payment",
        "loan_amount",
        "closing_cost_pct",
        "closing_costs",
        "reserve_months",
        "reserves",
        "cash_needed",
        "rate_pct",
        "principal_interest_monthly",
        "property_tax_rate_pct",
        "property_tax_monthly",
        "insurance_rate_pct",
        "insurance_monthly",
        "piti_monthly",
        "pmi_rate_pct",
        "pmi_monthly",
        "monthly_payment"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "CreateImportForm": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Account label applied to every row",
          "title": "Account"
        }
      },
      "title": "CreateImportForm",
      "type": "object"
    },
    "CreateImportResponse": {
      "additionalProperties": false,
      "properties": {
        "import_id": {
          "format": "uuid",
          "title": "Import Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ImportStatus"
        }
      },
      "required": [
        "import_id",
        "status"
      ],
      "title": "CreateImportResponse",
      "type": "object"
    },
    "CreatePlanRequest": {
      "additionalProperties": false,
      "description": "Free text (\"I want a $420,000 home with 10% down by June 2028\"), form fields, or both.",
      "properties": {
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomeGoalDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "CreatePlanRequest",
      "type": "object"
    },
    "CreatePlanResponse": {
      "additionalProperties": false,
      "description": "Open GET /api/plans/{plan_id}/events next to follow progress.",
      "properties": {
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id"
      ],
      "title": "CreatePlanResponse",
      "type": "object"
    },
    "CreditScoreRange": {
      "enum": [
        "<620",
        "620-679",
        "680-739",
        "740+"
      ],
      "title": "CreditScoreRange",
      "type": "string"
    },
    "Cut": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Monthly reduction, positive",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Amount",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "current_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Current Monthly",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'Subscriptions, 7 down to 3'",
          "title": "Detail"
        },
        "ease": {
          "$ref": "#/$defs/Ease"
        },
        "new_monthly": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "New Monthly",
          "type": "string"
        }
      },
      "required": [
        "category",
        "current_monthly",
        "amount",
        "new_monthly",
        "ease"
      ],
      "title": "Cut",
      "type": "object"
    },
    "CutEdit": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "New monthly reduction; 0 drops the cut",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Amount",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        }
      },
      "required": [
        "category",
        "amount"
      ],
      "title": "CutEdit",
      "type": "object"
    },
    "Ease": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Ease",
      "type": "string"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FixedBill": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "monthly_amount": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Monthly Amount",
          "type": "string"
        },
        "name": {
          "description": "Display name, e.g. 'Rent' or 'Student loan minimum'",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "monthly_amount"
      ],
      "title": "FixedBill",
      "type": "object"
    },
    "GuideSource": {
      "enum": [
        "cfpb",
        "hud",
        "glossary"
      ],
      "title": "GuideSource",
      "type": "string"
    },
    "HomeGoal": {
      "additionalProperties": false,
      "description": "A complete goal. parse_goal produces it; ask_user fills whatever is missing.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "credit_score_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreditScoreRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "down_pct": {
          "description": "Down payment, percentage points (3, 3.5, 10, 20)",
          "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
          "title": "Down Pct",
          "type": "string"
        },
        "move_in": {
          "description": "Target move-in date",
          "format": "date",
          "title": "Move In",
          "type": "string"
        },
        "price": {
          "description": "Target home price",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Price",
          "type": "string"
        },
        "saved": {
          "description": "Cash already set aside for the home",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Saved",
          "type": "string"
        },
        "zip": {
          "pattern": "^\\d{5}$",
          "title": "Zip",
          "type": "string"
        }
      },
      "required": [
        "price",
        "zip",
        "move_in",
        "down_pct",
        "saved"
      ],
      "title": "HomeGoal",
      "type": "object"
    },
    "HomeGoalDraft": {
      "additionalProperties": false,
      "description": "Whatever the user supplied so far; any field may be missing.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "credit_score_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreditScoreRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "down_pct": {
          "anyOf": [
            {
              "description": "Percentage points: \"10\" means 10%, \"6.27\" means 6.27%",
              "gt": 0,
              "pattern": "^\\d{1,3}(\\.\\d{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Down Pct"
        },
        "move_in": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Move In"
        },
        "price": {
          "anyOf": [
            {
              "description": "US dollars, e.g. \"1200.00\"",
              "gt": 0,
              "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "saved": {
          "anyOf": [
            {
              "description": "US dollars, e.g. \"1200.00\"",
              "ge": 0,
              "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saved"
        },
        "zip": {
          "anyOf": [
            {
              "pattern": "^\\d{5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zip"
        }
      },
      "title": "HomeGoalDraft",
      "type": "object"
    },
    "ImportResponse": {
      "additionalProperties": false,
      "properties": {
        "categorized_by_llm": {
          "default": 0,
          "title": "Categorized By Llm",
          "type": "integer"
        },
        "categorized_by_rule": {
          "default": 0,
          "title": "Categorized By Rule",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duplicates_skipped": {
          "default": 0,
          "title": "Duplicates Skipped",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "filenames": {
          "items": {
            "type": "string"
          },
          "title": "Filenames",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "import_id": {
          "format": "uuid",
          "title": "Import Id",
          "type": "string"
        },
        "rows_inserted": {
          "default": 0,
          "title": "Rows Inserted",
          "type": "integer"
        },
        "rows_parsed": {
          "default": 0,
          "title": "Rows Parsed",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ImportStatus"
        }
      },
      "required": [
        "import_id",
        "status",
        "filenames",
        "created_at"
      ],
      "title": "ImportResponse",
      "type": "object"
    },
    "ImportStatus": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "ImportStatus",
      "type": "string"
    },
    "PlanResponse": {
      "additionalProperties": false,
      "properties": {
        "cash_needed": {
          "anyOf": [
            {
              "description": "US dollars, e.g. \"1200.00\"",
              "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cash Needed"
        },
        "cashflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cashflow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cuts": {
          "items": {
            "$ref": "#/$defs/Cut"
          },
          "title": "Cuts",
          "type": "array"
        },
        "goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/HomeGoal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "home_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "monthly_target": {
          "anyOf": [
            {
              "description": "US dollars, e.g. \"1200.00\"",
              "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monthly saving needed to reach cash_needed by move_in",
          "title": "Monthly Target"
        },
        "on_track": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Track"
        },
        "pending_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Question"
        },
        "plan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "projection": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Projection",
          "type": "array"
        },
        "reach_month": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reach Month"
        },
        "review_rounds": {
          "default": 0,
          "title": "Review Rounds",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PlanStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "PlanResponse",
      "type": "object"
    },
    "PlanStatus": {
      "enum": [
        "running",
        "awaiting_input",
        "awaiting_review",
        "done",
        "failed"
      ],
      "title": "PlanStatus",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "description": "One month on the savings chart. points[0] is the clock's current month at `start`.",
      "properties": {
        "balance": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Balance",
          "type": "string"
        },
        "month": {
          "format": "date",
          "title": "Month",
          "type": "string"
        },
        "target": {
          "description": "US dollars, e.g. \"1200.00\"",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "month",
        "balance",
        "target"
      ],
      "title": "Point",
      "type": "object"
    },
    "ReviewAction": {
      "enum": [
        "approve",
        "edit",
        "reject"
      ],
      "title": "ReviewAction",
      "type": "string"
    },
    "ReviewRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "edits": {
          "description": "Required when action=edit",
          "items": {
            "$ref": "#/$defs/CutEdit"
          },
          "title": "Edits",
          "type": "array"
        },
        "unlock": {
          "description": "Protected categories the user allows the solver to cut",
          "items": {
            "$ref": "#/$defs/Category"
          },
          "title": "Unlock",
          "type": "array"
        }
      },
      "required": [
        "action"
      ],
      "title": "ReviewRequest",
      "type": "object"
    },
    "ReviewResponse": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "review_rounds": {
          "title": "Review Rounds",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PlanStatus"
        }
      },
      "required": [
        "plan_id",
        "status",
        "review_rounds"
      ],
      "title": "ReviewResponse",
      "type": "object"
    }
  },
  "title": "Home Fund API"
}
